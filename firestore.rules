rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'Admin';
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          request.resource.data.get('status', 'Pending Approval') == resource.data.get('status', 'Pending Approval') &&
          request.resource.data.get('role', '') == resource.data.get('role', '')
        )
      );
      allow delete: if isAdmin();
    }

    match /users/{uid}/aiHistory/{entry} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/memberAIHistory/{entry} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /elevate360/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
