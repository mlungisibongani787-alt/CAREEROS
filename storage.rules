rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // No anonymous uploads and no public bucket browsing.
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
